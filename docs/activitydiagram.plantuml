@startuml resource-reservation-system-activity-diagram

title Resource Reservation Lifecycle - Activity Diagram

start
:User opens reservation form;
:Submit create request
(Start, End, ResourceId, User info);

if (Start < End?) then (yes)
  if (Duration >= 60 minutes?) then (yes)
    if (Resource exists?) then (yes)
      if (No overlap with active reservations?) then (yes)
        :Create Reservation (Status=PENDING);
        :Save to database;
      else (no)
        :Reject request
(Overlapping reservation);
        stop
      endif
    else (no)
      :Reject request
(Resource not found);
      stop
    endif
  else (no)
    :Reject request
(Duration less than 60 minutes);
    stop
  endif
else (no)
  :Reject request
(Invalid time window);
  stop
endif

fork
  :Admin reviews reservation;
  if (Decision) then (Approve)
    :Set status=APPROVED;
    :Send approval email;
  elseif (Deny)
    :Set status=DENIED;
    :Send denial email;
  else (Cancel)
    :Set status=CANCELLED
(only PENDING/APPROVED);
    :Send cancellation email;
  endif
fork again
  :Background worker runs every 60s;
  if (Now >= Start and status is APPROVED?) then (yes)
    :Set status=ONGOING;
  elseif (Now >= Start and status is PENDING)
    :Set status=DENIED;
  endif

  if (Now >= End and status is ONGOING?) then (yes)
    :Set status=DONE;
  endif
end fork

stop

@enduml
